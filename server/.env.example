# Copy to server/.env and edit. Every variable is optional; these are the defaults.

# --- LLM ---------------------------------------------------------------------
# anthropic = Claude reads the message and phrases the answer (needs a key).
# fake      = offline demo mode: keyword rules read the message, templates write the answer.
LLM_PROVIDER=anthropic
# Your key from https://console.anthropic.com. Falls back to the ANTHROPIC_API_KEY env var.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max, for writing the reply.
ANTHROPIC_EFFORT=medium
# Effort for reading the message into an intent (a small, frequent call; low is enough).
INTENT_EFFORT=low
# LLM calls in flight at once.
MAX_CONCURRENCY=4

# --- Live feed ---------------------------------------------------------------
# simulated = replay samples/live_replay.csv on an accelerated clock (default, no network).
# http      = the stub adapter for a third-party running-status API. UNVERIFIED: read
#             docs/data-sources.md first. Never point it at NTES or IRCTC pages.
LIVE_SOURCE=simulated
# How often the in-process poller asks the source for new events. 0 = off (then run
# `python -m app.cli ingest --watch` as a separate process).
LIVE_POLL_SECONDS=5
# Simulated feed: where its clock starts (IST) and how many times faster than real time
# it runs. 10 = one simulated hour every six real minutes.
LIVE_START=2026-11-27T12:00:00
LIVE_SPEED=10
# Third-party running-status API (LIVE_SOURCE=http only).
RUNNING_STATUS_API_URL=
RUNNING_STATUS_API_KEY=
RUNNING_STATUS_TIMEOUT=10
# Identify yourself to any API you call.
HTTP_USER_AGENT=rail-delay-agent/0.1 (+https://github.com/aditya699/rail-delay-agent)

# --- Storage -----------------------------------------------------------------
# The SQLite database lives here (relative to server/).
DATA_DIR=data
# Any SQLAlchemy URL; defaults to SQLite inside DATA_DIR.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/rail

# --- App ---------------------------------------------------------------------
# Load samples/history.csv.gz into an empty database on start, then build the models.
SEED_DEMO=true
# Where network.json, analysis.json and chat.json live.
# CONFIG_DIR=app/config
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
